# Example frontend settings. Copy to frontend/.env for local development:
#   cp frontend/.env.example frontend/.env
# This file IS committed — never put secrets here. Only PUBLIC_-prefixed
# variables are exposed to browser code by Vite.
# Use the SAME host you open the frontend on (localhost here). Mixing
# localhost/127.0.0.1 across the two makes API calls cross-site, so the
# SameSite=Lax session cookie gets dropped and you can't stay logged in.
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# PRODUCTION: served single-origin (frontend + API under one host), so this is
# the relative path "/api/v1" — no absolute URL, no CORS. It is baked into the
# client bundle at BUILD time (Vite inlines PUBLIC_* vars), passed as the
# frontend Dockerfile's PUBLIC_API_BASE_URL build ARG (default /api/v1), NOT a
# runtime env var.
