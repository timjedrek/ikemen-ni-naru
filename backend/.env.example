# Example backend settings. Copy to backend/.env and fill in real values:
#   cp backend/.env.example backend/.env
# This file IS committed — never put real secrets here.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Security ---
# Generate a real value with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# The +psycopg suffix tells SQLAlchemy to use the psycopg 3 driver.
# Credentials/host/db must match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://health:health@localhost:5432/health

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
