# Keep the build context small and the image clean of local-only cruft.
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local env / secrets — config comes from injected env vars at runtime, never
# from a baked-in .env.
.env
.env.*
!.env.example

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
